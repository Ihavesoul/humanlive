<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Redesign v2 ([DRE-211](/DRE/issues/DRE-211)): the exercise-card image slot
      renders license-clean REMOTE images (media library DRE-207) via Coil's
      OkHttp fetcher, which needs INTERNET. This is the app's FIRST network
      permission — the app stays offline-first for everything load-bearing: plan
      generation, the safety gate, the evidence catalog, and persistence all run
      locally with no round-trip. Only the image BYTES are fetched; Coil's disk
      cache keeps a once-loaded image available offline, and a cache miss degrades
      gracefully to the branded placeholder (never a crash, never a broken icon).
      INTERNET is normal-protection (granted at install, no runtime prompt).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DreamTeam">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DreamTeam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          M7-B (DRE-73): FileProvider so the "Export my data" action can hand the
          deterministic export file to the system share/save sheet via a content
          URI. Standard Android component (androidx.core), NOT a new external
          dependency — reuses the androidx.core already on the classpath. Only
          the app's own cache export dir is exposed; grant is per-launch.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_file_paths" />
        </provider>
    </application>

</manifest>
